# Gemini API key from Google AI Studio, created in the GCP project that holds the hackathon credits
GEMINI_API_KEY=
# Model IDs (list available ones: curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY")
GEMINI_MODEL=
GEMMA_MODEL=
# OAuth 2.0 web client ID (Gmail read-only), passed to the browser at runtime
GOOGLE_CLIENT_ID=
# Optional: comma-separated fallback Gemini models used on 429/5xx
GEMINI_FALLBACK_MODELS=
# OAuth 2.0 web client secret, used server-side to exchange the GIS auth code for a refresh token
GOOGLE_CLIENT_SECRET=
# GCP project ID that holds Pub/Sub and Firestore (good-foreigner)
GOOGLE_CLOUD_PROJECT=
# Full Pub/Sub topic name Gmail watch publishes to (projects/<project>/topics/gmail-inbox)
PUBSUB_TOPIC=
# Random 32+ char secret; must match the token query param on the Pub/Sub push endpoint
PUSH_VERIFICATION_TOKEN=
# 32 random bytes, base64 (openssl rand -base64 32); AES-256-GCM key for stored refresh tokens
TOKEN_ENCRYPTION_KEY=
# Web Push VAPID public key (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
# Web Push VAPID private key (npx web-push generate-vapid-keys)
VAPID_PRIVATE_KEY=
# VAPID contact subject, a URL or mailto: (the Cloud Run service URL)
VAPID_SUBJECT=
# Set to true to show the real-time alerts feature; anything else hides it
REALTIME_ENABLED=
