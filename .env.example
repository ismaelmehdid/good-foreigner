# Gemini API key from Google AI Studio, created in the GCP project that holds the hackathon credits
GEMINI_API_KEY=
# Model IDs (list available ones: curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY")
GEMINI_MODEL=
GEMMA_MODEL=
# OAuth 2.0 web client ID (Gmail read-only), passed to the browser at runtime
GOOGLE_CLIENT_ID=
